{
  "openapi": "3.1.0",
  "info": {
    "title": "Решения Правительствующего Сената — Static API",
    "version": "1.4.0",
    "description": "Статические JSON-файлы: доступны GET и HEAD, query-параметров и серверного поиска нет."
  },
  "servers": [
    {
      "url": "https://ivseliv.github.io/senat/lex/api/v1"
    }
  ],
  "paths": {
    "/manifest.json": {
      "get": {
        "summary": "Точка входа и контрольные суммы",
        "responses": {
          "200": {
            "description": "JSON UTF-8",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schema.json#/$defs/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/corpus.json": {
      "get": {
        "summary": "Покрытие корпуса и ограничения",
