    },
    "/decisions/{year}.json": {
      "get": {
        "summary": "Полные решения за год",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [
                1896,
                1897,
                1904,
                1905
              ]
            }
          }
        ],
        "responses": {
          "200": {
