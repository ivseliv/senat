      "get": {
        "summary": "Решение по постоянному ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{3}$"
            }
          }
        ],
        "responses": {
          "200": {
